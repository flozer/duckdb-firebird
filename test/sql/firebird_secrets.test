# name: test/sql/firebird_secrets.test
# description: connection errors never echo the password
# group: [firebird]
#
# Port 1 refuses connections, so each attach fails after the connection
# string was parsed. No Firebird server needed, only the client library.
#
# The connection strings go through variables: DuckDB itself quotes the
# start of the failing statement ("LINE 1: ...") in a bind error, and a
# literal there would show the password whatever the extension does.

require firebird

# Space-separated key=value (the form of the function examples)
statement ok
SET VARIABLE cs = 'database=localhost/1:/nowhere/x.fdb user=SYSDBA password=Sekr3tPw';

statement error
SELECT * FROM firebird_scan(getvariable('cs'), 'T');
----
<!REGEX>:.*Sekr3tPw.*

# ... and it is parsed as key=value: the error names only the database.
statement error
SELECT * FROM firebird_scan(getvariable('cs'), 'T');
----
isc_attach_database(localhost/1:/nowhere/x.fdb)

# Semicolon key=value
statement ok
SET VARIABLE cs = 'database=localhost/1:/nowhere/x.fdb;user=SYSDBA;password=Sekr3tPw';

statement error
SELECT * FROM firebird_scan(getvariable('cs'), 'T');
----
<!REGEX>:.*Sekr3tPw.*

# URL with user info
statement ok
SET VARIABLE cs = 'firebird://SYSDBA:Sekr3tPw@localhost:1/nowhere/x.fdb';

statement error
SELECT * FROM firebird_scan(getvariable('cs'), 'T');
----
<!REGEX>:.*Sekr3tPw.*

# A string that is not key=value at all is a bare path; a password inside it
# is still removed.
statement ok
SET VARIABLE cs = 'localhost/1:/nowhere/password=Sekr3tPw.fdb';

statement error
SELECT * FROM firebird_scan(getvariable('cs'), 'T');
----
<!REGEX>:.*Sekr3tPw.*

# ATTACH connects on first use; neither the error nor the database path
# shown by duckdb_databases() carries the password.
statement ok
ATTACH 'database=localhost/1:/nowhere/x.fdb user=SYSDBA password=Sekr3tPw' AS s (TYPE firebird);

statement error
SELECT * FROM s.main.T;
----
<!REGEX>:.*Sekr3tPw.*

statement error
SELECT * FROM s.main.T;
----
isc_attach_database(localhost/1:/nowhere/x.fdb)

query I
SELECT path FROM duckdb_databases() WHERE database_name = 's';
----
localhost/1:/nowhere/x.fdb

statement ok
ATTACH 'localhost/1:/nowhere/password=Sekr3tPw.fdb' AS s2 (TYPE firebird);

query I
SELECT path LIKE '%Sekr3tPw%' FROM duckdb_databases() WHERE database_name = 's2';
----
false

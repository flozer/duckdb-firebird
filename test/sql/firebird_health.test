# name: test/sql/firebird_health.test
# description: firebird_health - single-row DB/server health diagnostic:
#              factual metrics (version/ODS/dialect/charset/page/durability/
#              sweep/transaction counters/attachments) + structured warnings.
# group: [firebird]

require firebird

require-env FIREBIRD_TEST_DB

require-env ISC_PASSWORD

statement error
SELECT * FROM firebird_health(NULL);
----
firebird_health(alias VARCHAR): alias is required

statement error
SELECT * FROM firebird_health('nope_does_not_exist_xyz');
----
firebird_health: no attached catalog named 'nope_does_not_exist_xyz'

statement error
SELECT * FROM firebird_health('memory');
----
firebird_health: catalog 'memory' is not a Firebird ATTACH

statement ok
ATTACH '${FIREBIRD_TEST_DB}' AS fb (TYPE firebird);

# Exactly one row.
query I
SELECT COUNT(*) FROM firebird_health('fb');
----
1

# Factual shape/range checks (exact transaction numbers vary per session).
query IIIIIII
SELECT
  CASE WHEN engine_version <> '' THEN 1 ELSE 0 END,
  CASE WHEN regexp_matches(ods_version, '^[0-9]+\.[0-9]+$') THEN 1 ELSE 0 END,
  CASE WHEN sql_dialect = 3 THEN 1 ELSE 0 END,
  CASE WHEN page_size > 0 THEN 1 ELSE 0 END,
  CASE WHEN next_transaction > 0 THEN 1 ELSE 0 END,
  CASE WHEN oit_gap >= 0 AND oat_gap >= 0 THEN 1 ELSE 0 END,
  CASE WHEN attachments >= 1 THEN 1 ELSE 0 END
FROM firebird_health('fb');
----
1	1	1	1	1	1	1

# Default charset of the UTF8 fixture, and no charset_none warning for it.
query TT
SELECT default_charset, list_contains(warnings, 'charset_none')
FROM firebird_health('fb');
----
UTF8	false

# warnings is a LIST(VARCHAR) (type-stable even when empty/non-empty).
query T
SELECT typeof(warnings) FROM firebird_health('fb');
----
VARCHAR[]

# ---------------------------------------------------------------------------
#  Inline blobs (Firebird 5.0.3+ client AND server). client_version is the
#  loaded fbclient (normalized to major.minor.patch.build); inline_blob_size
#  is the effective limit, or NULL when either side is older than 5.0.3
#  or the attachment is not TCP (a 5.0.3+ client reports a size even where
#  nothing is inlined, so the server version and network_protocol decide
#  too).
# ---------------------------------------------------------------------------

query I
SELECT regexp_matches(client_version, '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')
FROM firebird_health('fb');
----
true

# network_protocol is the attachment's transport, NULL when embedded.
query I
SELECT network_protocol IS NULL OR network_protocol IN ('TCPv4', 'TCPv6', 'XNET', 'WNET')
FROM firebird_health('fb');
----
true

statement ok
CREATE OR REPLACE TABLE inline_expect AS
SELECT
  (CAST(split_part(engine_version, '.', 1) AS INTEGER) * 10000 +
   CAST(split_part(engine_version, '.', 2) AS INTEGER) * 100 +
   CAST(split_part(engine_version, '.', 3) AS INTEGER)) >= 50003 AS server_ok,
  (CAST(split_part(client_version, '.', 1) AS INTEGER) * 10000 +
   CAST(split_part(client_version, '.', 2) AS INTEGER) * 100 +
   CAST(split_part(client_version, '.', 3) AS INTEGER)) >= 50003 AS client_ok,
  -- The server inlines blobs only over TCP (not XNET, not embedded).
  coalesce(network_protocol LIKE 'TCP%', false) AS tcp
FROM firebird_health('fb');

# Default (setting -1, nothing sent): the client's built-in default (65535
# in 5.0.3, a compile-time constant of the client) when both sides support
# it over TCP, NULL otherwise. Exact values are asserted only for explicit
# settings below. The warning fires only for a 5.0.3+ server reached over
# TCP through an older client.
query II
SELECT
  CASE WHEN e.server_ok AND e.tcp AND e.client_ok THEN h.inline_blob_size >= 0
       ELSE h.inline_blob_size IS NULL END,
  list_contains(h.warnings, 'inline_blobs_unavailable') = (e.server_ok AND e.tcp AND NOT e.client_ok)
FROM firebird_health('fb') h, inline_expect e;
----
true	true

# A new ATTACH picks up the session setting: 0 disables inlining.
statement ok
SET firebird_max_inline_blob_size = 0;

statement ok
ATTACH '${FIREBIRD_TEST_DB}' AS fb_noinline (TYPE firebird);

query I
SELECT CASE WHEN e.server_ok AND e.tcp AND e.client_ok THEN h.inline_blob_size = 0
            ELSE h.inline_blob_size IS NULL END
FROM firebird_health('fb_noinline') h, inline_expect e;
----
true

statement ok
DETACH fb_noinline;

# Out of range: rejected when a connection would be opened (ATTACH or a
# firebird_scan() bind), with the accepted range in the message.
statement ok
SET firebird_max_inline_blob_size = 70000;

statement error
ATTACH '${FIREBIRD_TEST_DB}' AS fb_bad (TYPE firebird);
----
firebird_max_inline_blob_size must be -1 (client default) or 0..65535

statement error
SELECT COUNT(*) FROM firebird_scan('${FIREBIRD_TEST_DB}', 'EMPLOYEE');
----
firebird_max_inline_blob_size must be -1 (client default) or 0..65535

statement ok
SET firebird_max_inline_blob_size = -1;

# A small limit: blobs up to 16 bytes come inline (FILE_STORAGE: 5 and 6
# bytes), larger ones the usual way (TBLOB_MULTISEG: 4020 bytes, multi-
# segment). Both must read the same bytes as through the default ATTACH.
statement ok
SET firebird_max_inline_blob_size = 16;

statement ok
ATTACH '${FIREBIRD_TEST_DB}' AS fb_small (TYPE firebird);

query I
SELECT CASE WHEN e.server_ok AND e.tcp AND e.client_ok THEN h.inline_blob_size = 16
            ELSE h.inline_blob_size IS NULL END
FROM firebird_health('fb_small') h, inline_expect e;
----
true

query II
SELECT
  (SELECT string_agg(md5(NOTE) || md5(DATA), ',' ORDER BY ID) FROM fb_small.main.TBLOB_MULTISEG) =
  (SELECT string_agg(md5(NOTE) || md5(DATA), ',' ORDER BY ID) FROM fb.main.TBLOB_MULTISEG),
  (SELECT string_agg(coalesce(md5(PAYLOAD), 'null'), ',' ORDER BY FILE_ID) FROM fb_small.main.FILE_STORAGE) =
  (SELECT string_agg(coalesce(md5(PAYLOAD), 'null'), ',' ORDER BY FILE_ID) FROM fb.main.FILE_STORAGE);
----
true	true

# The same bytes as the known fixture values, not just the same as each
# other.
query I
SELECT string_agg(coalesce(md5(PAYLOAD), 'null'), ',' ORDER BY FILE_ID) =
       md5('binary'::BLOB) || ',null,' || md5('hello'::BLOB)
FROM fb_small.main.FILE_STORAGE;
----
true

statement ok
DETACH fb_small;

statement ok
RESET firebird_max_inline_blob_size;
